{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "jsdoc",
    "node",
    "oxc",
    "promise",
    "typescript",
    "unicorn",
    "eslint"
  ],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error",
    "restriction": "error"
  },
  "rules": {
    "typescript/no-non-null-assertion": "off",
    "unicorn/no-array-reduce": "off"
  },
  "env": {
    "builtin": true,
    "node": true
  }
}
